<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key><string>com.ainkrad.plugin.rune</string>
    <key>CFBundleName</key><string>RunePlugin</string>
    <!-- Required: the host installer renames the bundle to <appID>.bundle
         (rune.bundle), so CFBundle's filename-based executable fallback
         ("rune") would miss the real executable. Declare it explicitly. -->
    <key>CFBundleExecutable</key><string>RunePlugin</string>
    <key>CFBundlePackageType</key><string>BNDL</string>
    <key>NSPrincipalClass</key><string>RuneEntryPoint</string>
    <!-- Overlay + basic: the "quick command on the run" case is a transient
         surface, not a pane to keep around. Advanced is still a full session. -->
    <key>AinkradPresentation</key><string>overlay</string>
    <key>AinkradMode</key><string>basic</string>
    <key>AinkradAppID</key><string>rune</string>
    <key>AinkradDisplayName</key><string>Rune</string>
    <key>AinkradIconSymbol</key><string>terminal</string>
    <key>AinkradAPIVersion</key><integer>7</integer>
</dict>
</plist>
